# Copy to .env and fill in to use an OpenAI-compatible API.
# Leave OPENAI_API_KEY empty to run fully offline (local hashing embeddings
# + extractive answers) — great for demos and tests.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Local embedded Qdrant storage path
QDRANT_PATH=./data/qdrant

# Default number of chunks retrieved per question
TOP_K=4
